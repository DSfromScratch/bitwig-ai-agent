# HuggingFace Token (für gated Datasets wie CoT_Music_Production_DAW)
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── LLM-Backend ──────────────────────────────────────────────────────────────
# "vllm" → Linux vLLM-Server als Primary (GPU, 16GB VRAM, max-model-len 4096)
#           Bei Verbindungsfehler: automatischer Fallback auf Mac MLX
# "mlx"  → Mac MLX-Server als Primary (Unified Memory, kein Netzwerk nötig)
LLM_BACKEND=vllm

# Mac MLX-Server (mlx_lm.server, Port 8080)
MAC_MLX_URL=http://localhost:8080
MLX_MODEL=mlx-community/Qwen3-14B-4bit

# Linux vLLM-Server (192.168.0.3:8100, 16GB VRAM)
# Start: vllm serve ./models/Qwen3-14B-AWQ --max-model-len 4096 --gpu-memory-utilization 0.90
VLLM_BASE_URL=http://192.168.0.3:8100
VLLM_MODEL=./models/Qwen3-14B-AWQ

# Max Output-Tokens (MLX: 2000, vLLM mit 16GB: 1500 empfohlen)
LLM_MAX_TOKENS=2000

# ── Neo4j Graph Database ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jllm
NEO4J_DATABASE=neo4j

# ── Bitwig OSC ────────────────────────────────────────────────────────────────
BITWIG_HOST=127.0.0.1
BITWIG_STEP_PORT=8002
BITWIG_STEP_REPLY_PORT=9002

# ── Embedding-Server ──────────────────────────────────────────────────────────
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_PORT=8082
KB_EMBED_MODEL=intfloat/multilingual-e5-base

# ── Linux QLoRA Training ──────────────────────────────────────────────────────
# Basismodell für SFT + DPO (HuggingFace-ID oder lokaler Pfad)
TRAIN_BASE_MODEL=Qwen/Qwen3-14B
# Verzeichnis mit train.jsonl / valid.jsonl / dpo_train.jsonl
TRAIN_DATA_DIR=./training_data
# Zielverzeichnis für den trainierten LoRA-Adapter
TRAIN_ADAPTER_DIR=./adapters/bitwig-agent
# Maximale Sequenzlänge in Tokens (16GB VRAM: 2048, 24GB: 4096)
TRAIN_MAX_SEQ=2048
# LoRA-Rank und Skalierung
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
# Batch-Größe × Gradient-Akkumulation = effektiver Batch (hier: 1×8=8)
TRAIN_BATCH=1
TRAIN_GRAD_ACC=8
# Lernrate und Scheduler-Schritte
TRAIN_LR=2e-4
TRAIN_ITERS=300
TRAIN_WARMUP=30

# ── Music Flamingo (optional) ─────────────────────────────────────────────────
MUSIC_FLAMINGO_MODEL=nvidia/music-flamingo-2601-hf

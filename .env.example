# HuggingFace Token (für gated Datasets wie CoT_Music_Production_DAW)
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# vLLM Server
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=./models/Qwen3-14B-AWQ

# Music Flamingo (läuft direkt im Agent-Prozess, kein Server nötig)
MUSIC_FLAMINGO_MODEL=nvidia/music-flamingo-2601-hf

# Neo4j Graph Database (Windows, via WSL2 localhost)
# Instanz: audio-llm | neo4j.com/download → Neo4j Desktop
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jllm
NEO4J_DATABASE=neo4j

# Bitwig OSC
BITWIG_HOST=127.0.0.1
BITWIG_OSC_PORT=8000
BITWIG_DM_PORT=8001

# Embedding Endpoint (vom Agent verwendet)
EMBEDDING_BASE_URL=http://127.0.0.1:8080

# Lokaler Embedding-Server Port (primary + optional fallback)
EMBEDDING_PORT=8080
EMBEDDING_FALLBACK_PORT=8081

# Embedding-Modell für Neo4j Vektorsuche
KB_EMBED_MODEL=intfloat/multilingual-e5-base

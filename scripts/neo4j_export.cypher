MERGE (n:Workflow {name: 'Dubstep Half-Time Drums'})
SET n.osc_steps = '[{"cmd": "/track/add/instrument", "comment": "Drum-Track anlegen"}, {"cmd": "/browser/device/load Drum Machine", "comment": "Drum Machine laden"}, {"cmd": "/drum/pad/pitch/enter 36", "comment": "Kick-Pad betreten (MIDI pitch 36)"}, {"cmd": "/browser/device/load v9 Kick", "comment": "v9 Kick in Kick-Pad laden"}, {"cmd": "/drum/pad/pitch/enter 38", "comment": "Snare-Pad betreten (MIDI pitch 38)"}, {"cmd": "/browser/device/load v9 Snare", "comment": "v9 Snare in Snare-Pad laden"}, {"cmd": "/drum/pad/pitch/enter 42", "comment": "HiHat-Pad betreten (MIDI pitch 42)"}, {"cmd": "/browser/device/load v9 Hat Closed", "comment": "v9 Hat Closed in HiHat-Pad laden"}, {"cmd": "/track/add/instrument", "comment": "Bass-Track für Sidechain anlegen"}, {"cmd": "/browser/device/load Compressor", "comment": "Compressor auf Bass-Track laden"}, {"note": "Sidechain-Input muss manuell in Bitwig UI gesetzt werden — kein OSC-Befehl verfügbar"}, {"cmd": "/device/param/named threshold 0.25", "comment": "Threshold -20dB"}, {"cmd": "/device/param/named ratio 0.5", "comment": "Ratio 6:1"}, {"cmd": "/device/param/named attack 0.15", "comment": "Attack 2ms"}, {"cmd": "/device/param/named release 0.35", "comment": "Release 80ms"}]',
        n.description = 'Half-Time Drum-Pattern für Dark Dubstep',
        n.steps = 'v9 Kick auf Kick-Pad (MIDI 36): Tune -18, Punch 0.8, Decay 0.5s
v9 Snare auf Snare-Pad (MIDI 38): Beat 3 (half-time), Reverb 1.5s
v9 Hat Closed auf HiHat-Pad (MIDI 42): 8tel-Noten, vel 60/100 alternierend
Sidechain: Compressor auf Bass-Track, Input=Kick
Sidechain: Threshold -20dB, Ratio 6:1, Attack 2ms, Release 80ms';
MERGE (n:Workflow {name: 'Dubstep Reese Bass'})
SET n.osc_steps = '[{"cmd": "/track/add/instrument", "comment": "Neuen Instrument-Track anlegen"}, {"cmd": "/browser/device/load FM-4", "comment": "FM-4 Synthesizer laden (UUID-Insert, kein Browser nötig)"}, {"cmd": "/device/param/named algorithm 0.5", "comment": "FM-Algorithmus: Op1→Op2 Kette"}, {"cmd": "/device/param/named op1_ratio 0.5", "comment": "Op1 Ratio = 1.0 (normalized ~0.5)"}, {"cmd": "/device/param/named op2_ratio 0.6", "comment": "Op2 Ratio = 1.5 (normalized ~0.6)"}, {"cmd": "/device/param/named op1_tune 0.52", "comment": "Op1 Detune +8 Cents"}, {"cmd": "/browser/device/load Distortion", "comment": "Distortion-FX hinzufügen"}, {"cmd": "/device/param/named drive 0.4", "comment": "Distortion Drive = 0.4"}, {"cmd": "/browser/device/load Ladder", "comment": "Ladder-Filter laden"}, {"cmd": "/device/param/named cutoff 0.45", "comment": "Cutoff ~800Hz"}, {"cmd": "/device/param/named resonance 0.3", "comment": "Resonance = 0.3"}, {"cmd": "/browser/device/load Compressor", "comment": "Compressor laden"}, {"cmd": "/device/param/named threshold 0.3", "comment": "Threshold -18dB"}, {"cmd": "/device/param/named ratio 0.4", "comment": "Ratio 4:1"}, {"cmd": "/device/param/named attack 0.15", "comment": "Attack 2ms"}]',
        n.description = 'Klassischer Reese-Bass für Dubstep',
        n.steps = 'FM-4 auf Bass-Track laden
Algorithmus: Op1 moduliert Op2 (Kette)
Op1 Ratio: 1.0, Op2 Ratio: 1.5
Op1 Detune: +8 Cents
Distortion: Mode=Fold, Drive=0.4
Ladder-Filter: Cutoff 800Hz, Resonance 0.3
Compressor: Threshold -18dB, Ratio 4:1, Attack 2ms';
MERGE (n:Workflow {name: 'Editing Curves in the Curve Editor'})
SET n.use_case = 'When you need to design custom modulation curves for devices or modulators.',
        n.description = 'A workflow for creating and modifying curves using the Curve Editor in Bitwig Studio.',
        n.source = 'p452-454',
        n.steps = '["Click on a curve display to open the Curve Editor in a resizable window.", "Use the available tools (Pointer, Pencil, Step, Half Step, Saw Up, Saw Down, Triangle) to draw or modify curves.", "Set the grid size using the 4 x 4 type control in the bottom left of the Curve Editor.", "Use the Larger Beat Grid command (default: [.]) to adjust the grid size to the nearest duplet value.", "Use the Smaller Beat Grid command (default: [,]) to adjust the grid size to the nearest smaller duplet value.", "Use the Next Beat Grid Subdivision command (default: [ALT]+[.]) to adjust the grid to the nearest triplet value.", "Use the Previous Beat Grid Subdivision command (default: [ALT]+[,]) to adjust the grid to the nearest smaller triplet value.", "Use the Toggle Snap command (default: [S]) to enable or disable snapping to the grid.", "Hold [SHIFT] to temporarily disable snapping while drawing.", "Use [CTRL] ([CMD] on Mac) to move a segment or point and all following points.", "Use [ALT] to bend a segment or draw inverse curves around a point.", "Use [ALT]+[SHIFT] to draw identical curves around a point.", "Right-click in the Curve Editor to access Transform options for adjusting the entire curve."]',
        n.tips = '["Use the Curve Browser to load pre-made curves or save your own with a name, description, category, and tags.", "Use the pop-out icon in device panels to access custom editors for specific modulators like the Steps (Sequence) modulator."]';
MERGE (n:Workflow {name: 'Editing Modulation Data with the Curve Editor'})
SET n.use_case = 'When you need to create or modify complex modulation curves for devices that support BWCURVE files.',
        n.description = 'Edit curve-based modulation data using the Curve Editor.',
        n.source = 'p449-451',
        n.steps = '["Open the Pop-out Editor for the modulator or module that contains editable playback data.", "Use the Curve Editor to draw and edit the modulation curve as needed."]',
        n.tips = '["Use the Curve Editor for precise control over modulation curves, similar to how automation is edited."]';

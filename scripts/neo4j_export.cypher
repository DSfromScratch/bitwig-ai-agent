        n.steps = '["Enable Voice Stacking on the parent device.", "Open the Stack Spread device and select a spread mode (e.g., \'0 to 1\' or \'Flipped\').", "Adjust the modulation level to control the amount of modulation applied to each voice.", "Use the \'Manual\' mode to create a custom distribution of values across voices."]',
        n.tips = '["Use the \'Golden\' mode for Fibonacci-based modulation.", "Experiment with different spread modes to find the best modulation effect for your sound."]';
MERGE (n:Workflow {name: 'Using Sub Scenes in the Clip Launcher'})
SET n.use_case = 'When working with group tracks and needing to organize or trigger specific clips within them.',
        n.description = 'Use sub scenes to manage and trigger clips within group tracks in the Clip Launcher.',
        n.source = 'p177-179',
        n.steps = '["Each group track has its own row of sub scenes.", "Sub scenes use color blocks to indicate which tracks have clips within that sub scene.", "Sub scenes can be dragged, copied, pasted, deleted, or used as sources/destinations for clip dragging between the Launcher and Arranger."]',
        n.tips = '["Sub scenes act as aliases for the clips they contain, making it easier to manage complex group track setups."]';
MERGE (n:Workflow {name: 'Using Track Headers'})
SET n.use_case = 'When you need to quickly adjust track settings or monitor track levels during arrangement.',
        n.description = 'Access and manage track settings, such as color, type, name, volume, mute, and solo states.',
        n.source = 'p72-74',
        n.steps = '["Locate the track headers to the left of the Arrange area.", "Use the Track Color stripe to identify tracks visually.", "Use the Track Type icon to determine the type of track.", "Edit the Track Name for clarity.", "Adjust the Volume fader to control the track\'s output level.", "Use the Record Arm button to enable recording on the track.", "Use the Solo button to isolate the track\'s audio output.", "Use the Mute button to disable the track\'s audio output.", "Click the Automation Lane button to access the automation lane section."]',
        n.tips = '["Use the Level meters to monitor the track\'s output level in real-time."]';
MERGE (n:Workflow {name: 'Using Wavetable Synthesis'})
SET n.use_case = 'Useful for creating metallic or evolving sounds using wavetable synthesis.',
        n.description = 'A workflow for using the Cycles mode in the Sampler device to create wavetable-based sounds.',
        n.source = 'p592-594',
        n.steps = '["Load a WAV file with a \'clm\' chunk into the Sampler device.", "Switch to the Cycles mode in the play mode section.", "Adjust the Root key to set the appropriate size for the wavetables.", "Use the Formant parameter to shift the timbre of the sound.", "Experiment with different playback modes and modulation sources to create unique sounds."]',
        n.tips = '["Use the \'Cycles\' mode for wavetable synthesis and formant shifting.", "Disable keyboard tracking for pitch to create metallic or evolving sounds."]';
MERGE (n:Workflow {name: 'Using the Browser Search'})
SET n.use_case = 'When you need to find specific audio sources, instruments, or effects quickly.',
        n.description = 'Efficiently search for and select content using the browser\'s search field and autocomplete suggestions.',
        n.source = 'p99-101',
        n.steps = '["Open the browser.", "Start typing in the search field.", "Use autocomplete suggestions by pressing [TAB] or clicking the blue button.", "If results are limited, switch to the Everything source to expand search options."]',
        n.tips = '["Press [DOWN ARROW] to move focus to the results list.", "Press [UP ARROW] to return focus to the search field.", "Press [S] to return to the search field from anywhere in the browser."]';
MERGE (n:Workflow {name: 'Using the Chain Device'})
SET n.use_case = 'When you need to apply multiple effects in series to an audio signal and control the balance between the original and processed signals.',
        n.description = 'Process audio signals with a series of effects while maintaining control over the balance between the original and processed signals.',
        n.source = 'p532-534',
        n.steps = '["Insert the Chain device into the audio signal path.", "Add effects to the Chain device\'s serial chain.", "Use the Mix control to balance the dry and wet signals.", "Use the Wet Gain control to adjust the level of the dry signal.", "Click the L button to automatically set the Wet Gain to match the incoming dry signal level."]',
        n.tips = '["The Learn Wet Gain function runs for 25 seconds or until the L button is clicked again."]';
MERGE (n:Workflow {name: 'Using the Clip Launcher Panel'})
SET n.use_case = 'When you need to trigger clips spontaneously or for live performance.',
        n.description = 'Understand and use the Clip Launcher Panel for improvisation and live performance.',
        n.source = 'p171-173',
        n.steps = '["Access the Clip Launcher Panel either in the Arranger Timeline Panel or the Mixer Panel.", "Use the slots to house clips and trigger them as needed.", "Use the Stop Clips button to halt all clips on a track.", "Use the Switch Playback to Arranger button to toggle between Launcher and Arranger clips."]',
        n.tips = '["Use the horizontal scroll bar to view all clip slots if there are more than can be shown at once.", "Launcher clips are ideal for live performance and improvisation, while Arranger clips are better for structured composition."]';
MERGE (n:Workflow {name: 'Using the FX Layer Device'})
SET n.use_case = 'When you need to apply multiple parallel effects to the same audio signal with independent control over each chain.',
        n.description = 'Apply multiple parallel effects to the same audio signal with independent control over each chain.',
        n.source = 'p532-534',
        n.steps = '["Insert the FX Layer device into the audio signal path.", "Add multiple audio chains to the FX Layer device.", "Use the internal mixer controls to adjust the levels of each chain independently."]',
        n.tips = '["Use the internal mixer controls to adjust the levels of each chain independently."]';
MERGE (n:Workflow {name: 'Using the FX Selector Device'})
SET n.use_case = 'When you need to switch between different audio processing chains based on triggers or automation.',
        n.description = 'Switch between different audio processing chains based on triggers or automation.',
        n.source = 'p532-534',
        n.steps = '["Insert the FX Selector device into the audio signal path.", "Add multiple audio chains to the FX Selector device.", "Use the Note/MIDI Source chooser to select a track to receive notes from.", "Use the Fade Out and Fade In controls to create smooth transitions between chains."]',
        n.tips = '["Use the Note/MIDI Source chooser to select a track to receive notes from."]';
MERGE (n:Workflow {name: 'Using the File Kind Filter'})
SET n.use_case = 'To narrow down search results to a specific file type, such as audio samples or device presets.',
        n.description = 'Access and use the File Kind filter to isolate results to specific file types.',
        n.source = 'p102-104',
        n.steps = '["Press [F] from most browser locations to alternate focus between the File Kind filter and the more specific File Type filter."]',
        n.tips = '["Icons appear at the end of the filter section to help identify device- or preset-based selections."]';
MERGE (n:Workflow {name: 'Using the Inspector Panel'})
SET n.use_case = 'When you need to adjust track or device parameters quickly.',
        n.description = 'To access and modify parameters of selected objects in the Arrange view.',
        n.source = 'p81-83',
        n.steps = '["Click the \'i\' icon in the window\'s footer to toggle the Inspector Panel visibility.", "Select an object in the Arrange view.", "The Inspector Panel will display relevant parameters for the selected object."]',
        n.tips = '["The Inspector Panel updates dynamically based on the selected object."]';
MERGE (n:Workflow {name: 'Using the Instrument Layer Device'})
SET n.use_case = 'When you need to layer multiple instruments or sounds simultaneously with independent control over each.',
        n.description = 'Layer multiple instruments or sounds simultaneously with independent control over each.',
        n.source = 'p532-534',
        n.steps = '["Insert the Instrument Layer device into the audio signal path.", "Add multiple instruments to the Instrument Layer device.", "Use the internal mixer controls to adjust the levels of each instrument chain independently."]',
        n.tips = '["Use the internal mixer controls to adjust the levels of each instrument chain independently."]';
MERGE (n:Workflow {name: 'Using the Instrument Selector Device'})
SET n.use_case = 'When you need to switch between different instrument layers based on note input, MIDI controllers, or automation.',
        n.description = 'Switch between different instrument layers based on note input, MIDI controllers, or automation.',
        n.source = 'p532-534',
        n.steps = '["Insert the Instrument Selector device into the audio signal path.", "Add multiple instruments and their associated device chains to the Instrument Selector device.", "Use the voice Mode options to control how new notes are assigned to layers."]',
        n.tips = '["Use the voice Mode options to control how new notes are assigned to layers."]';
MERGE (n:Workflow {name: 'Using the Location Filter'})
SET n.use_case = 'To filter content based on its origin, such as local libraries, Bitwig Studio content, or installed packages.',
        n.description = 'Access and use the Location filter to specify where content is sourced from.',
        n.source = 'p102-104',
        n.steps = '["Press [L] from most browser locations to move focus to the Location filter.", "Click on top-level items to show results from that entire location, or unfold entries for more specificity."]',
        n.tips = '["Use the Location filter to drag and drop items into user collections."]';
MERGE (n:Workflow {name: 'Using the Mid-Side Split Device'})
SET n.use_case = 'When you need to apply different processing to the center and stereo components of a stereo signal.',
        n.description = 'Apply different processing to the center and stereo components of a stereo signal.',
        n.source = 'p532-534',
        n.steps = '["Insert the Mid-Side Split device into the audio signal path.", "Add effects to the mid and side chains independently."]',
        n.tips = '["Use the independent chains to apply different effects to the mid and side components."]';
MERGE (n:Workflow {name: 'Using the Mix Parameter for Blending'})
SET n.use_case = 'When you want to control the balance between dry and wet signals in an effect.',
        n.description = 'Blend original and processed signals using the Mix parameter on a device.',
        n.source = 'p431-433',
        n.steps = '["Locate the Mix parameter in the bottom right corner of the device.", "Adjust the Mix parameter to control the balance between dry and wet signals.", "Set to 100% for full wet signal or 0% to bypass the device."]',
        n.tips = '["Use the Mix parameter to create subtle effects without losing the original sound."]';
MERGE (n:Workflow {name: 'Using the Multiband FX-2 Device'})
SET n.use_case = 'When you need to apply different effects to different frequency ranges of an audio signal.',
        n.description = 'Apply different effects to different frequency ranges of an audio signal.',
        n.source = 'p532-534',
        n.steps = '["Insert the Multiband FX-2 device into the audio signal path.", "Adjust the split frequency to define the boundary between the two chains.", "Add effects to the low and high frequency chains independently."]',
        n.tips = '["Adjust the split frequency to define the boundary between the two chains."]';
MERGE (n:Workflow {name: 'Using the Multiband FX-3 Device'})
SET n.use_case = 'When you need to apply different effects to three distinct frequency ranges of an audio signal.',
        n.description = 'Apply different effects to three distinct frequency ranges of an audio signal.',
        n.source = 'p532-534',
        n.steps = '["Insert the Multiband FX-3 device into the audio signal path.", "Adjust the two split frequencies to define the boundaries between the three chains.", "Add effects to the low, mid, and high frequency chains independently."]',
        n.tips = '["Adjust the two split frequencies to define the boundaries between the three chains."]';
MERGE (n:Workflow {name: 'Using the On-Screen Keyboard for Note Entry'})
SET n.use_case = 'When entering notes directly on a tablet.',
        n.description = 'Use the On-Screen Keyboard Panel to play and create notes on a tablet.',
        n.source = 'p521-523',
        n.steps = '["Open the Play View in the Tablet display profile.", "Locate the On-Screen Keyboard Panel at the bottom of the view.", "Select a keyboard mode (Piano, Octaves, or Fourths).", "Use your finger or stylus to play notes and input micro-pitch expressions by dragging side to side."]',
        n.tips = '["Use multitouch input to play multiple notes at once.", "Experiment with different keyboard modes to find the one that best suits your workflow."]';
MERGE (n:Workflow {name: 'Using the Steps Device for Sequencing'})
SET n.use_case = 'Use when designing rhythmic patterns with modulation control.',
        n.description = 'Create a rhythmic sequence using the Steps device with modulation and tempo sync.',
        n.source = 'p610-612',
        n.steps = '["Add the Steps device to the modulation chain.", "Set the step count and direction for the sequencer.", "Assign modulation sources to the steps for dynamic changes.", "Use the \'Transport\' or \'Free running\' trigger mode based on your needs.", "Use the \'Note / Random\' mode for randomized playback."]',
        n.tips = '["Use the \'Free running\' mode for independent playback not tied to the transport.", "Use the \'Note / Random\' mode to add unpredictability to your sequences."]';
MERGE (n:Workflow {name: 'Viewing Module Help'})
SET n.use_case = 'When learning how to use a specific module or its parameters.',
        n.description = 'Access detailed documentation for a module directly in the interface.',
        n.source = 'p494-496',
        n.steps = '["Select the module in the current patch.", "Choose Show Help Item from the Module menu.", "Alternatively, click the Show Help button in the Inspector Panel or press [F1]."]',
        n.tips = '["The help view shows real-time signal indicators and allows parameter adjustments."]';
MERGE (n:Workflow {name: 'Vowel Morphing'})
SET n.use_case = 'When creating vocal-like effects or morphing between vowel sounds',
        n.description = 'Create smooth transitions between different vowel sounds',
        n.source = 'p631-633',
        n.steps = '["Open the Vowels device and select the desired vowel positions.", "Use the Vowel Blend knob to transition between the selected vowel positions.", "Adjust the Drive control to add warmth and saturation to the vowel sounds.", "Use automation or modulation to create dynamic vowel transitions."]',
        n.tips = '["Experiment with different vowel positions and blend settings to achieve the desired effect."]';
MERGE (n:Workflow {name: 'Working with Meta Clips and Group Tracks'})
SET n.use_case = 'When managing multiple tracks within a group track and needing to manipulate them as a single unit.',
        n.description = 'Use meta clips to represent and manipulate clips within group tracks in the Arranger Timeline.',
        n.source = 'p141-143',
        n.steps = '["Group tracks will have meta clips that summarize their enclosed tracks in the Arranger Timeline.", "If clips within the group track are overlapping, meta clips will show colorized summaries of the track contents.", "Meta clips can be moved, cut, copied, pasted, deleted, or split using the Knife tool, and these actions affect the clips they represent."]',
        n.tips = '["A project navigation menu appears at the top of the Arranger Timeline Panel when working with group tracks."]';
MERGE (n:Workflow {name: 'Zooming in the Arranger Timeline'})
SET n.use_case = 'When you need to see more detail or get an overview of the timeline.',
        n.description = 'Adjust the zoom level to view and navigate the timeline more effectively.',
        n.source = 'p69-71',
        n.steps = '["Place the mouse in-line with the bar numbers inside the Beat Ruler.", "Click and hold the mouse button, dragging upward to zoom in or downward to zoom out.", "Alternatively, press [PLUS] or [CTRL]+[PLUS] ([CMD]+[PLUS] on Mac) to zoom in and [MINUS] or [CTRL]+[MINUS] ([CMD]+[MINUS] on Mac) to zoom out.", "Hold [CTRL]+[ALT], then click and drag anywhere within the Arranger area to zoom.", "If your mouse or trackpad supports scrolling, hold [CTRL]+[ALT] and scroll up or down.", "If you have a three-button mouse, click and drag the middle button anywhere within the Arranger area.", "If you have a trackpad (particularly on Mac), pinch or stretch two fingers diagonally on the trackpad."]',
        n.tips = '["Use horizontal scrolling by dragging the mouse from side to side within the Arranger Timeline."]';

// ── Sound (13 Nodes) ─────────────────────────────────────────────
MERGE (n:Sound {name: '808 Bass'})
SET n.settings = 'Tune -12, Decay 2.0s, Sub Level 1.0',
        n.description = 'Langer Sub-Sine Bass. Trap/Hip-Hop.',
        n.category = 'bass';
MERGE (n:Sound {name: 'Blues Lead'})
SET n.settings = 'find_guitar_loops(key, bpm, loop_type=\'GuitarLead\'); leichte Distortion+Amp',
        n.description = 'Blues-Gitarren-Lead Loop mit Bend-Charakter. Pentatonik.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Clean Guitar'})
SET n.settings = 'find_guitar_loops(key, bpm, loop_type=\'GuitarChords\'); kein Distortion',
        n.description = 'Sauberer Gitarren-Loop. Pop, Blues, Funk.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Dark Pad'})
SET n.settings = 'Saw+Saw detune, LP-Filter 30%, Reverb 4s, Attack 0.5s',
        n.description = 'Dunkles Atmosphären-Pad. Minor Chords, viel Reverb.',
        n.category = 'atmosphere';
MERGE (n:Sound {name: 'Half-Time Snare'})
SET n.settings = 'Noise 0.7, Decay 0.4s, Reverb 1.5s',
        n.description = 'Snare auf Beat 3 (Halftime-Feel). Typisch Dubstep.',
        n.category = 'drums';
MERGE (n:Sound {name: 'Heavy Guitar'})
SET n.settings = 'find_guitar_loops(key, bpm, loop_type=\'GuitarRiff\'); Distortion Drive=0.8+Amp',
        n.description = 'Stark verzerrter Gitarren-Loop. Metal, Heavy Rock.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Lead Guitar'})
SET n.settings = 'find_guitar_loops(key, bpm, loop_type=\'GuitarLead\') → load_guitar_loop()',
        n.description = 'Lead-Gitarren Loop mit Sustain. Rock, Metal.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Lead Synth'})
SET n.settings = 'Saw, Phase-Mod 0.3, Filter 60% + Env, LFO Vibrato',
        n.description = 'Mono-Lead für Melodien und Hooks.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Reese Bass'})
SET n.settings = 'Op1+Op2 Ratio 1:1.5, Detune ±8 Cents, Distortion Fold 40%, Ladder-Filter 800Hz',
        n.description = 'Detuned sawtooth bass mit Modulation. Klassisch für Dubstep/DnB.',
        n.category = 'bass';
MERGE (n:Sound {name: 'Rock Guitar Riff'})
SET n.settings = 'find_guitar_loops(key, bpm) → load_guitar_loop(); Distortion+Amp FX hinzufügen',
        n.description = 'E-Gitarren-Riff Loop (WAV), Pentatonik, Distortion. Rock/Metal.',
        n.category = 'lead';
MERGE (n:Sound {name: 'Techno Kick'})
SET n.settings = 'Tune -18, Punch 0.8, Decay 0.3s, Click 0.5',
        n.description = 'Harter elektronischer Kick. Pitch-Drop, Sub-Punch.',
        n.category = 'drums';
MERGE (n:Sound {name: 'Vocal Chop'})
SET n.settings = 'Short samples, Gate, Reverb + Delay',
        n.description = 'Verarbeitete Vocal-Samples als rhythmisches Element.',
        n.category = 'fx';
MERGE (n:Sound {name: 'Wobble Bass'})
SET n.settings = 'Saw, LFO → Filter Cutoff, Rate sync 1/4, Depth 0.7',
        n.description = 'Bass mit rhythmisch moduliertem Filter. Charakteristisch Dubstep.',
        n.category = 'bass';


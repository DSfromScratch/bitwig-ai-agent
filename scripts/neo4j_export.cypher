MERGE (n:Concept {name: 'Quantize'})
SET n.use_case = 'To align audio events with the beat grid for rhythmic precision.',
        n.description = 'Shifts the start/end times of discrete audio events toward the beat grid. It uses the most recently set parameters for the function.',
        n.source = 'p150-152',
        n.category = 'automation';
MERGE (n:Concept {name: 'Quantize Audio'})
SET n.use_case = 'To precisely align audio content with the beat grid by analyzing internal onsets.',
        n.description = 'A high-level variation on the Quantize function that creates beat markers from certain onsets and shifts them closer to the beat grid, effectively quantizing the audio internally.',
        n.source = 'p150-152',
        n.category = 'automation';
MERGE (n:Concept {name: 'Replacer'})
SET n.use_case = 'When you want to generate MIDI notes based on audio input levels.',
        n.description = 'A container that filters and analyzes the level of the incoming audio signal, and when the signal rises above a set threshold, notes are generated at a set pitch and velocity. These notes and the original (dry) audio signal are then passed to the internal Generator device chain.',
        n.source = 'p534-535',
        n.category = 'device';
MERGE (n:Concept {name: 'Reverb'})
SET n.use_case = 'When adding spatial depth and ambiance to audio signals.',

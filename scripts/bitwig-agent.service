[Unit]
Description=Bitwig Audio Agent (LangGraph + OSC Listener Port 9003)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sija/Repro/bitwig-ai-agent
ExecStart=/home/sija/Repro/bitwig-ai-agent/.venv/bin/python -m src.agent.core
Restart=on-failure
RestartSec=10

EnvironmentFile=/home/sija/Repro/bitwig-ai-agent/.env
Environment=PYTHONUNBUFFERED=1

StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

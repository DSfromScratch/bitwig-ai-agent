MERGE (d:Document {source: 'Device:Ø Reverse', content: '**Ø Reverse** Inverts a proper phase signal Verwendung: Inverting phase signals for modulation'});
MERGE (d:Document {source: 'Device:Ø Saw', content: '**Ø Saw** Saw lookup module Verwendung: Used to generate saw waveforms based on phase signals'});
MERGE (d:Document {source: 'Device:Ø Scaler', content: '**Ø Scaler** Scales an incoming phase signal to be proportionally faster or slower Verwendung: Adjusting the speed of phase signals'});
MERGE (d:Document {source: 'Device:Ø Shift', content: '**Ø Shift** Offsets the incoming phase signal by a set amount Verwendung: Used to shift phase signals for modulation or audio processing'});
MERGE (d:Document {source: 'Device:Ø Sine', content: '**Ø Sine** Sine lookup module Verwendung: Used to generate sine waveforms based on phase signals'});
MERGE (d:Document {source: 'Device:Ø Sinemod', content: '**Ø Sinemod** Modulates the incoming phase signal with a sine wave Verwendung: Used to add sine wave modulation to phase signals'});
MERGE (d:Document {source: 'Device:Ø Skew', content: '**Ø Skew** Sets the incoming level to remap to +0.5 Verwendung: Used to adjust the incoming signal level for phase processing'});
MERGE (d:Document {source: 'Device:Ø Split', content: '**Ø Split** Equally distributes phase signal across up to 8 out ports Verwendung: Used to split phase signals into multiple outputs'});
MERGE (d:Document {source: 'Device:Ø Sync', content: '**Ø Sync** Amplifies the incoming phase signal before wrapping it Verwendung: Used to amplify and wrap phase signals for audio processing'});
MERGE (d:Document {source: 'Device:Ø Triangle', content: '**Ø Triangle** Triangle lookup module Verwendung: Used to generate triangle waveforms based on phase signals'});
MERGE (d:Document {source: 'Device:Ø Window', content: '**Ø Window** Cosine window module Verwendung: Used to apply cosine windowing to phase signals'});
MERGE (d:Document {source: 'Device:Ø Wrap', content: '**Ø Wrap** Wraps any signal into the phase signal range Verwendung: Converting signals into phase range for modulation'});

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bitwigagent</groupId>
  <artifactId>bitwig-agent-bridge</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.bitwig</groupId>
      <artifactId>bitwig-extension-api</artifactId>
      <version>18</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.14.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Java 25 compiler support -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <!-- JUnit 5 test runner -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Required for Mockito/ByteBuddy/Objenesis with Java 25 strong encapsulation -->
          <argLine>
            -Dnet.bytebuddy.experimental=true
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens java.base/java.util=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
      <!-- CVE fix: upgrade + force commons-io:2.16.1 (CVE-2024-47554, CVE-2021-29425) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.4.0</version>
        <dependencies>
          <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- CVE fixes in site plugin default lifecycle binding:
           commons-beanutils:1.11.0 (CVE-2019-10086, CVE-2025-48734)
           commons-compress:1.26.2 (CVE-2021-35515/16/17, CVE-2021-36090, CVE-2024-25710, CVE-2024-26308)
           commons-io:2.16.1 (CVE-2024-47554, CVE-2021-29425) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>3.12.1</version>
        <dependencies>
          <dependency>
            <groupId>commons-beanutils</groupId>
            <artifactId>commons-beanutils</artifactId>
            <version>1.11.0</version>
          </dependency>
          <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.26.2</version>
          </dependency>
          <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- Drei Extensions als separate JARs bauen -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <dependencies>
          <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
          </dependency>
        </dependencies>
        <!-- Standard-JAR deaktivieren — wir bauen drei separate via executions -->
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
        <executions>
          <!-- 1. BitwigAgentBridge (legacy — Agent + Launchpad kombiniert) -->
          <execution>
            <id>jar-agent-bridge</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>agent-bridge</classifier>
              <excludes>
                <exclude>com/bitwigagent/BitwigOscBridge*.class</exclude>
                <exclude>com/bitwigagent/LaunchpadController*.class</exclude>
              </excludes>
              <archive>
                <manifest>
                  <mainClass>com.bitwigagent.BitwigAgentBridgeDefinition</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <!-- 2. BitwigOscBridge (pure OSC, kein MIDI, kein Agent-UI) -->
          <execution>
            <id>jar-osc-bridge</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>osc-bridge</classifier>
              <excludes>
                <exclude>com/bitwigagent/BitwigAgentBridgeDefinition.class</exclude>
                <exclude>com/bitwigagent/LaunchpadController*.class</exclude>
              </excludes>
              <archive>
                <manifest>
                  <mainClass>com.bitwigagent.BitwigOscBridgeDefinition</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <!-- 3. LaunchpadController (standalone, 3 Modi: Control/Drum/Instrument) -->
          <execution>
            <id>jar-launchpad</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>launchpad</classifier>
              <excludes>
                <exclude>com/bitwigagent/BitwigAgentBridge*.class</exclude>
                <exclude>com/bitwigagent/BitwigOscBridge*.class</exclude>
              </excludes>
              <archive>
                <manifest>
                  <mainClass>com.bitwigagent.LaunchpadControllerDefinition</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <!-- 4. BitwigStepPlugin — State Machine + Step Executor (Port 8001) -->
          <execution>
            <id>jar-step-plugin</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>step-plugin</classifier>
              <excludes>
                <exclude>com/bitwigagent/BitwigAgentBridge*.class</exclude>
                <exclude>com/bitwigagent/BitwigOscBridge*.class</exclude>
                <exclude>com/bitwigagent/LaunchpadController*.class</exclude>
              </excludes>
              <archive>
                <manifest>
                  <mainClass>com.bitwigagent.BitwigStepPluginDefinition</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Nach dem Build: JARs als .bwextension kopieren -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <property name="build.dir"  value="${project.build.directory}"/>
                <property name="art.ver"    value="${project.artifactId}-${project.version}"/>

                <!-- 1. BitwigAgentBridge — services unverändert -->
                <copy file="${build.dir}/${art.ver}-agent-bridge.jar"
                      tofile="${project.basedir}/dist/BitwigAgentBridge.bwextension"/>

                <!-- 2. BitwigOscBridge — services auf OscBridgeDefinition korrigieren -->
                <copy file="${build.dir}/${art.ver}-osc-bridge.jar"
                      tofile="${build.dir}/BitwigOscBridge-fix.jar"/>
                <echo file="${build.dir}/osc-service.txt"
                      message="com.bitwigagent.BitwigOscBridgeDefinition"/>
                <zip destfile="${build.dir}/BitwigOscBridge-fix.jar" update="true">
                  <zipfileset file="${build.dir}/osc-service.txt"
                    fullpath="META-INF/services/com.bitwig.extension.ExtensionDefinition"/>
                </zip>
                <copy file="${build.dir}/BitwigOscBridge-fix.jar"
                      tofile="${project.basedir}/dist/BitwigOscBridge.bwextension"/>

                <!-- 3. LaunchpadController — services auf LaunchpadControllerDefinition korrigieren -->
                <copy file="${build.dir}/${art.ver}-launchpad.jar"
                      tofile="${build.dir}/LaunchpadController-fix.jar"/>
                <echo file="${build.dir}/lp-service.txt"
                      message="com.bitwigagent.LaunchpadControllerDefinition"/>
                <zip destfile="${build.dir}/LaunchpadController-fix.jar" update="true">
                  <zipfileset file="${build.dir}/lp-service.txt"
                    fullpath="META-INF/services/com.bitwig.extension.ExtensionDefinition"/>
                </zip>
                <copy file="${build.dir}/LaunchpadController-fix.jar"
                      tofile="${project.basedir}/dist/LaunchpadController.bwextension"/>

                <!-- 4. BitwigStepPlugin — services auf BitwigStepPluginDefinition -->
                <copy file="${build.dir}/${art.ver}-step-plugin.jar"
                      tofile="${build.dir}/BitwigStepPlugin-fix.jar"/>
                <echo file="${build.dir}/step-service.txt"
                      message="com.bitwigagent.BitwigStepPluginDefinition"/>
                <zip destfile="${build.dir}/BitwigStepPlugin-fix.jar" update="true">
                  <zipfileset file="${build.dir}/step-service.txt"
                    fullpath="META-INF/services/com.bitwig.extension.ExtensionDefinition"/>
                </zip>
                <copy file="${build.dir}/BitwigStepPlugin-fix.jar"
                      tofile="${project.basedir}/dist/BitwigStepPlugin.bwextension"/>

                <echo>
Extensions gebaut:
  dist/BitwigAgentBridge.bwextension   (legacy)
  dist/BitwigOscBridge.bwextension     (pure OSC Bridge)
  dist/LaunchpadController.bwextension (Launchpad: Control/Drum/Instrument)
  dist/BitwigStepPlugin.bwextension    (Step Executor — Port 8001)
                </echo>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
